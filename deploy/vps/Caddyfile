# beebots VPS (Oracle, /etc/caddy/Caddyfile). One site: the Colony, on 127.0.0.1 only. The Cloudflare tunnel on the
# same machine publishes it as beebots.covewrk.com (deploy/vps/cloudflared.yml). Engine: beebots-colony on 8080.
{
	admin off
}

http://:4170 {
	bind 127.0.0.1
	encode zstd gzip

	# Read-only engine endpoints. The colony has no owner controls: nothing on this site can change a bee.
	@api {
		method GET
		path /colony/* /events /snapshot /history /equity /health
	}
	handle @api {
		reverse_proxy 127.0.0.1:8080 {
			flush_interval -1
		}
	}

	# The built dashboard (dashboard/dist), with the colony page at the root.
	handle {
		root * /srv/dashboard
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		@home path /
		rewrite @home /colony.html
		try_files {path} /colony.html
		file_server
	}

	header {
		-Server
		X-Content-Type-Options nosniff
		X-Frame-Options SAMEORIGIN
		Referrer-Policy strict-origin-when-cross-origin
	}
}
